<?xml version="1.0"?>
<ruleset name="Demas Theme">
	<description>WordPress Coding Standards for the Demas block theme, run by CI (AMM-156).</description>

	<file>.</file>

	<!-- Compiled copies of src/*/render.php, dependencies, and local tooling output. -->
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/.playwright-mcp/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="s"/>

	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="demas-theme"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="demas_theme"/>
				<element value="demas"/>
			</property>
		</properties>
	</rule>
</ruleset>
