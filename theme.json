				"pill": "999px"
			},
			"notch": "18px",
			"rule": "1px solid color-mix(in srgb, var(--wp--preset--color--ink) 12%, transparent)",
			"motion": {
				"fast": "250ms",
				"base": "400ms",
				"slow": "550ms",
				"ease": "cubic-bezier(0.2, 0.7, 0.2, 1)",
				"stagger": "70ms"
			},
			"display": {
				"stretch": "125%",
				"tracking": "-0.02em",
				"leading": "0.98"
