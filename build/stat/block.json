{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "demas-theme/stat",
  "title": "Number",
  "category": "design",
  "icon": "performance",
  "description": "One number and what it counts. A whole number counts up from zero as it scrolls into view; it can carry a short word beside it and a drawing under it (a scale of years, or the branch network).",
  "textdomain": "demas-theme",
  "parent": [
    "demas-theme/stats"
  ],
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "supports": {
    "html": false,
    "reusable": false
  },
  "attributes": {
    "value": {
      "type": "string",
      "default": ""
    },
    "prefix": {
      "type": "string",
      "default": ""
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "unit": {
      "type": "string",
      "default": ""
    },
    "drawing": {
      "type": "string",
      "enum": [
        "",
        "scale",
        "network"
      ],
      "default": ""
    },
    "since": {
      "type": "string",
      "default": ""
    }
  }
}