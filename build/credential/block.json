{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "demas-theme/credential",
  "title": "Credential",
  "category": "design",
  "icon": "yes-alt",
  "description": "One certification or partnership mark, with an optional line of detail shown on hover and keyboard focus.",
  "textdomain": "demas-theme",
  "parent": [
    "demas-theme/credentials"
  ],
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "supports": {
    "html": false,
    "reusable": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "default": ""
    },
    "detail": {
      "type": "string",
      "default": ""
    }
  }
}