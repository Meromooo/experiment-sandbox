{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "demas-theme/credential",
  "title": "Credential",
  "category": "design",
  "icon": "yes-alt",
  "description": "One certificate or partner on the credentials belt: its logo on a plate, and a hang tag with what it is and who issued it, shown on hover and keyboard focus.",
  "textdomain": "demas-theme",
  "parent": [
    "demas-theme/credentials"
  ],
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "supports": {
    "html": false,
    "reusable": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "default": ""
    },
    "logo": {
      "type": "number",
      "default": 0
    },
    "detail": {
      "type": "string",
      "default": ""
    },
    "issuer": {
      "type": "string",
      "default": ""
    },
    "link": {
      "type": "string",
      "default": ""
    }
  }
}